PAY_USDT_ERC20=
PAY_ETH=
PAY_BTC=

# Optional API keys (higher rate limits)
TRONGRID_API_KEY=
ETHERSCAN_API_KEY=

# Local testing only. Never enable in production.
PAY_DEV_AUTO=0

# Fenix Markets (retail) UPI
UPI_VPA=yourname@okaxis
UPI_PAYEE=Fenix Markets
