PORT=5000
JWT_SECRET=change_me_to_a_long_random_string_at_least_32_chars
BCRYPT_ROUNDS=12
LOCKOUT_TRIES=5
LOCKOUT_MINUTES=15
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
TRADER_USERNAME=trader
TRADER_PASSWORD=
CODE_RED_SECRET=
